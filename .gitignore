/node_modules
/backend/node_modules
/frontend/node_modules
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# =========================
# ENVIRONMENT & SECRETS
# =========================
.env
.env.*
!.env.example
backend/.env
frontend/.env*

